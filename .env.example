# ─────────────────────────────────────────────────────────────
# VINO – Frontend-Umgebungsvariablen (kopieren nach .env.local)
# Nur öffentliche Werte! Diese landen im Browser-Bundle.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Supabase → Project Settings → API Keys → "anon"/"publishable" key
# (öffentlich, durch Row Level Security geschützt)
VITE_SUPABASE_ANON_KEY=dein-anon-oder-publishable-key

# Optional: Demo-Modus mit klar gekennzeichneten Beispieldaten.
# Speichert nichts in Supabase und ruft keine KI auf.
VITE_DEMO_MODE=false

# ─────────────────────────────────────────────────────────────
# NIEMALS hier eintragen (gehören in Supabase Secrets):
#   OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY
# Siehe supabase/functions/.env.example
# ─────────────────────────────────────────────────────────────
