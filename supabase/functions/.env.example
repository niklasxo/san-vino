# Secrets für Supabase Edge Functions.
# Lokal: Datei nach supabase/functions/.env kopieren (wird nicht committet).
# Cloud: supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY stellt Supabase
# den Functions automatisch bereit – sie müssen NICHT gesetzt werden.

OPENAI_API_KEY=sk-...
# Multimodales Modell (Bild + Text). Standard: gpt-5-mini
OPENAI_MODEL=gpt-5-mini
# Optional: eigenes Modell für Erklärungstexte (Standard = OPENAI_MODEL)
OPENAI_EXPLANATION_MODEL=
# Kostenschutz: maximale KI-Aufrufe pro Nutzer und Tag
VINO_DAILY_SCAN_LIMIT=25
VINO_DAILY_EXPLANATION_LIMIT=80
# Komma-separierte Liste erlaubter Origins für CORS (Standard: *)
VINO_ALLOWED_ORIGINS=http://localhost:5173
