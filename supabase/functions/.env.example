# Secrets für Supabase Edge Functions (im Dashboard: Edge Functions → Secrets).
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY stellt Supabase automatisch bereit.

# Kostenlos: https://aistudio.google.com/apikey (Google-Konto, keine Kreditkarte)
GEMINI_API_KEY=
# Optional – Standard: gemini-flash-latest
GEMINI_MODEL=
GEMINI_TEXT_MODEL=

# Optional: Anbieter erzwingen (gemini | openai). Ohne Angabe: der, dessen Key gesetzt ist.
AI_PROVIDER=
# Nur falls OpenAI (kostenpflichtig) genutzt werden soll
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Kostenschutz: maximale KI-Aufrufe pro Nutzer und Tag
VINO_DAILY_SCAN_LIMIT=25
VINO_DAILY_EXPLANATION_LIMIT=80
# Komma-separierte Liste erlaubter Origins für CORS (Standard: *)
VINO_ALLOWED_ORIGINS=
